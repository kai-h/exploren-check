# Copy to .env and fill in. .env is gitignored — it names your certificate and
# keychain profile, which are specific to your developer account.

# Apple Developer Team ID. Shown in the certificate name from:
#   security find-identity -v -p codesigning
TEAM_ID=XXXXXXXXXX

# The signing identity, exactly as that command prints it. The SHA-1 hash
# works too and is unambiguous if you hold more than one Developer ID cert.
SIGN_ID="Developer ID Application: Your Name (XXXXXXXXXX)"

# Name of the notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials <profile> \
#     --apple-id you@example.com --team-id XXXXXXXXXX
# It stores an app-specific password from appleid.apple.com, not your Apple ID
# password. Verify it independently of a release with:
#   xcrun notarytool history --keychain-profile <profile>
NOTARY_PROFILE=explorencheck

# Only used to make the recovery instructions copy-pasteable if notarisation
# comes back 401. Nothing authenticates with it directly.
APPLE_ID=you@example.com
